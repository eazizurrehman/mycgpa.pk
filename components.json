{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-lyra",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/app/_components",
    "utils": "@/lib/utils",
    "ui": "@/app/_shadcn",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@wds": "https://wds-shadcn-registry.netlify.app/r/{name}.json",
    "@diceui": "https://diceui.com/r/{name}.json",
    "@reui": "https://reui.io/r/{style}/{name}.json"
  }
}
